<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="ppai-bolsines" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>ppai.entidades.ComisionMedica</class>
        <class>ppai.entidades.Empleado</class>
        <class>ppai.entidades.Sesion</class>
        <class>ppai.entidades.TipoDocumento</class>
        <class>ppai.entidades.Estado</class>
        <class>ppai.entidades.Bolsin</class>
        <class>ppai.entidades.CambioEstadoBolsin</class>
        <class>ppai.entidades.Remito</class>
        <class>ppai.entidades.DetalleRemito</class>
        <class>ppai.entidades.Documentacion</class>
        <class>ppai.entidades.CambioEstadoDocumentacion</class>
        <class>ppai.persistencia.ConversorEstadoDocumentacion</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.sqlite.JDBC"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:sqlite:bolsines.db"/>
            <property name="hibernate.dialect" value="org.hibernate.community.dialect.SQLiteDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
