@startuml
skinparam style strictuml
skinparam shadowing false
skinparam roundcorner 0
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 60
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam defaultFontColor #000000
skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam classStereotypeFontStyle normal
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  ArrowColor #000000
  FontColor #000000
  AttributeFontColor #000000
  StereotypeFontColor #000000
}
hide circle


interface PantallaRecepcionBolsin <<interface>> {
  +solicitarConfirmacion(): void
}

class PantallaGraficaRecepcionBolsin <<boundary>> {
  -tomarConfirmacion(confirma: boolean): void
}

class GestorRecepcionBolsin <<control>> {
  -empleadoLogueado: Empleado
  -fechaYHora: LocalDateTime
  -opcionSeleccionada: OpcionRecepcion
  -documentacionIndicada: List<Integer>
  +tomarConfirmacion(confirma: boolean): void
  -getFechaYHoraActual(): LocalDateTime
}

class Bolsin <<entity>> {
  +recibir(fechaHora: LocalDateTime, responsable: Empleado): void
  +recibirYAceptarRemito(fechaHora: LocalDateTime, responsable: Empleado, opcion: OpcionRecepcion, documentacionIndicada: List<Integer>): void
  +setEstado(estado: EstadoBolsin): void
  +agregarCambioEstado(cambioEstado: CambioEstadoBolsin): void
  +getCambiosEstado(): List<CambioEstadoBolsin>
}

class CambioEstadoBolsin <<entity>> {
  -fechaHoraInicio: LocalDateTime
  -fechaHoraFin: LocalDateTime
  -responsableCE: Empleado
  +CambioEstadoBolsin(fechaHoraInicio: LocalDateTime, estado: EstadoBolsin, responsableCE: Empleado)
  +sosActual(): boolean
  +setFechaHoraFin(fechaHoraFin: LocalDateTime): void
}

class Remito <<entity>> {
  +recibirYAceptar(fechaHora: LocalDateTime, responsable: Empleado, opcion: OpcionRecepcion, documentacionIndicada: List<Integer>): void
  +tenesDocumentacionIndicada(documentacionIndicada: List<Integer>): boolean
  +setEstado(estado: EstadoRemito): void
  +getDetallesRemito(): List<DetalleRemito>
}

class DetalleRemito <<entity>> {
  +esDocumentacionIndicada(documentacionIndicada: List<Integer>): boolean
  +recibirYAceptarDoc(fechaHora: LocalDateTime, responsable: Empleado, opcion: OpcionRecepcion, documentacionIndicada: List<Integer>): void
}

class Documentacion <<entity>> {
  +recibir(fechaHora: LocalDateTime, responsable: Empleado, situacion: SituacionDocumentacion): void
  +setEstado(estado: EstadoDocumentacion): void
  +agregarCambioEstado(cambioEstado: CambioEstadoDocumentacion): void
  +getCambiosEstado(): List<CambioEstadoDocumentacion>
}

class CambioEstadoDocumentacion <<entity>> {
  -fechaHoraInicio: LocalDateTime
  -fechaHoraFin: LocalDateTime
  -responsableCE: Empleado
  +CambioEstadoDocumentacion(fechaHoraInicio: LocalDateTime, estado: EstadoDocumentacion, responsableCE: Empleado)
  +sosActual(): boolean
  +setFechaHoraFin(fechaHoraFin: LocalDateTime): void
}

enum OpcionRecepcion <<enumeration>> {
  CONTENIDO_IGUAL
  NO_SE_RECIBE_TODA
  NO_CORRESPONDE
  REDIRIGIR
  --
  -descripcion: String
  -dejaRemitoParcial: boolean
  +getSituacionDocumentacionIndicada(): SituacionDocumentacion
  +dejaRemitoParcial(): boolean
}

enum SituacionDocumentacion <<enumeration>> {
  IGUAL_A_LA_REGISTRADA
  NO_RECIBIDA
  NO_CORRESPONDE_A_LA_CM_DESTINO
  PARA_REDIRIGIR
  --
  -descripcion: String
}

abstract class Estado {
  -nombre: String
  -descripcion: String
  #Estado(nombre: String, descripcion: String)
  +getNombre(): String
  +getDescripcion(): String
}

together {
abstract class EstadoBolsin {
  #EstadoBolsin(nombre: String, descripcion: String)
  +esEnviado(): boolean
  +recibir(bolsin: Bolsin, fechaHora: LocalDateTime, responsable: Empleado): void
  #crearCambioEstado(estado: EstadoBolsin, fechaHora: LocalDateTime, responsable: Empleado): CambioEstadoBolsin
}
class "Creado" as BCreado
class "Cerrado" as BCerrado
class "Enviado" as BEnviado {
  +esEnviado(): boolean
  +recibir(bolsin: Bolsin, fechaHora: LocalDateTime, responsable: Empleado): void
  -crearEstado(): EstadoBolsin
}
class "RecibidoEnCMDestino" as BRecibido
class "DeBaja" as BDeBaja
}

together {
abstract class EstadoRemito {
  #EstadoRemito(nombre: String, descripcion: String)
  +recibirYAceptar(remito: Remito, fechaHora: LocalDateTime, responsable: Empleado, opcion: OpcionRecepcion, documentacionIndicada: List<Integer>): void
}
class "Creado" as RCreado
class "Cancelado" as RCancelado
class "EnBolsinSaliente" as REnBolsinSaliente
class "EnBolsinEnviado" as REnBolsinEnviado {
  +recibirYAceptar(remito: Remito, fechaHora: LocalDateTime, responsable: Empleado, opcion: OpcionRecepcion, documentacionIndicada: List<Integer>): void
  -crearEstado(remito: Remito, opcion: OpcionRecepcion, documentacionIndicada: List<Integer>): EstadoRemito
  -actualizarEstadoDocumentacion(detallesRemito: List<DetalleRemito>, fechaHora: LocalDateTime, responsable: Empleado, opcion: OpcionRecepcion, documentacionIndicada: List<Integer>): void
}
class "RemitoRecibidoYAceptado" as RRecibido
class "RemitoRecibidoYAceptadoParcial" as RParcial
}

together {
abstract class EstadoDocumentacion {
  #EstadoDocumentacion(nombre: String, descripcion: String)
  +recibir(documentacion: Documentacion, fechaHora: LocalDateTime, responsable: Empleado, situacion: SituacionDocumentacion): void
  #recepcionInvalida(documentacion: Documentacion, situacion: SituacionDocumentacion): IllegalStateException
  #crearCambioEstado(estado: EstadoDocumentacion, fechaHora: LocalDateTime, responsable: Empleado): CambioEstadoDocumentacion
}
class "Registrada" as DRegistrada
class "EnRemito" as DEnRemito
class "EnBolsinSaliente" as DEnBolsinSaliente
class "EnBolsinEnviado" as DEnBolsinEnviado {
  +recibir(documentacion: Documentacion, fechaHora: LocalDateTime, responsable: Empleado, situacion: SituacionDocumentacion): void
  -crearEstado(situacion: SituacionDocumentacion): EstadoDocumentacion
}
class "ParaRedirigir" as DParaRedirigir {
  +recibir(documentacion: Documentacion, fechaHora: LocalDateTime, responsable: Empleado, situacion: SituacionDocumentacion): void
  -crearEstado(situacion: SituacionDocumentacion): EstadoDocumentacion
}
class "NoRecibida" as DNoRecibida
class "RecibidaYAceptada" as DRecibidaYAceptada
class "RecibidaYRechazada" as DRecibidaYRechazada
class "DeBaja" as DDeBaja
}

PantallaGraficaRecepcionBolsin ..|> PantallaRecepcionBolsin
PantallaGraficaRecepcionBolsin --> "1" GestorRecepcionBolsin : -gestor
GestorRecepcionBolsin --> "1" PantallaRecepcionBolsin : -pantalla
GestorRecepcionBolsin --> "0..1" Bolsin : -bolsinSeleccionado

Bolsin *-- "1..*" Remito : -remitos
Bolsin *-- "1..*" CambioEstadoBolsin : -cambiosEstado
Bolsin --> "1" EstadoBolsin : -estadoActual
CambioEstadoBolsin --> "1" EstadoBolsin : -estado

Remito *-- "1..*" DetalleRemito : -detallesRemito
Remito --> "1" EstadoRemito : -estado
DetalleRemito --> "1" Documentacion : -documentacion

Documentacion *-- "1..*" CambioEstadoDocumentacion : -cambiosEstado
Documentacion --> "1" EstadoDocumentacion : -estadoActual
CambioEstadoDocumentacion --> "1" EstadoDocumentacion : -estado

OpcionRecepcion --> "1" SituacionDocumentacion : -situacionDocumentacionIndicada

Estado <|-- EstadoBolsin
Estado <|-- EstadoRemito
Estado <|-- EstadoDocumentacion

EstadoBolsin <|-- BCreado
EstadoBolsin <|-- BCerrado
EstadoBolsin <|-- BEnviado
EstadoBolsin <|-- BRecibido
EstadoBolsin <|-- BDeBaja

EstadoRemito <|-- RCreado
EstadoRemito <|-- RCancelado
EstadoRemito <|-- REnBolsinSaliente
EstadoRemito <|-- REnBolsinEnviado
EstadoRemito <|-- RRecibido
EstadoRemito <|-- RParcial

EstadoDocumentacion <|-- DRegistrada
EstadoDocumentacion <|-- DEnRemito
EstadoDocumentacion <|-- DEnBolsinSaliente
EstadoDocumentacion <|-- DEnBolsinEnviado
EstadoDocumentacion <|-- DParaRedirigir
EstadoDocumentacion <|-- DNoRecibida
EstadoDocumentacion <|-- DRecibidaYAceptada
EstadoDocumentacion <|-- DRecibidaYRechazada
EstadoDocumentacion <|-- DDeBaja
@enduml
