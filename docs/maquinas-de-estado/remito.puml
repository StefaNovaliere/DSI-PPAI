@startuml
!pragma layout smetana
title Máquina de estados de la clase Remito (según ERS v1.2)
skinparam state {
  BackgroundColor #F8CECC
  BorderColor #B85450
  FontName Arial
}
skinparam ArrowFontName Arial
skinparam ArrowFontSize 11
hide empty description

state "Creado" as Creado
state "Cancelado" as Cancelado
state "En bolsín saliente" as EnBolsinSaliente
state "En bolsín enviado" as EnBolsinEnviado
state "Recibido y aceptado" as RecibidoYAceptado
state "Recibido y aceptado parcial" as RecibidoYAceptadoParcial

[*] --> Creado : CU 15 Generar remito /\nnew()
Creado --> Creado : CU 16 Modificar remito\n(agregar o quitar documentación) /\nmodificar()
Creado --> Cancelado : CU 17 Cancelar remito /\ncancelar()
Creado --> EnBolsinSaliente : CU 19 Generar bolsín,\nCU 20 Modificar bolsín (agregar) /\nagregarABolsin()
EnBolsinSaliente --> Creado : CU 20 Modificar bolsín (quitar),\nCU 21 Eliminar bolsín /\nquitarDeBolsin()
EnBolsinSaliente --> EnBolsinEnviado : CU 27 Registrar el retiro\nde bolsines / enviar()
EnBolsinEnviado -[#C0392B,bold]-> RecibidoYAceptado : <color:#C0392B><b>CU 28 [contenido igual\n<color:#C0392B><b>al registrado] / recibirYAceptar()
EnBolsinEnviado -[#C0392B,bold]-> RecibidoYAceptadoParcial : <color:#C0392B><b>CU 28 [no se recibe toda\n<color:#C0392B><b>la documentación] /\n<color:#C0392B><b>recibirYAceptarParcial()
Cancelado --> [*]
RecibidoYAceptado --> [*]
RecibidoYAceptadoParcial --> [*]
@enduml
