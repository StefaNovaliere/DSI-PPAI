@startuml
!pragma layout smetana
title Máquina de estados de la clase Documentación (corregida según ERS v1.2)
skinparam state {
  BackgroundColor #F8CECC
  BorderColor #B85450
  FontName Arial
}
skinparam ArrowFontName Arial
skinparam ArrowFontSize 11
hide empty description

state "Registrada" as Registrada
state "En remito" as EnRemito
state "En bolsín saliente" as EnBolsinSaliente
state "En bolsín enviado" as EnBolsinEnviado
state "Recibida y aceptada" as RecibidaYAceptada
state "No recibida" as NoRecibida
state "Recibida y rechazada" as RecibidaYRechazada
state "Para redirigir" as ParaRedirigir
state "De baja" as DeBaja

[*] --> Registrada : CU 7 Registrar documentación /\nnew()
Registrada --> EnRemito : CU 15 Generar remito,\nCU 16 Modificar remito (agregar) /\nremitar()
EnRemito --> Registrada : CU 16 Modificar remito (quitar),\nCU 17 Cancelar remito /\ncancelarRemito()
EnRemito --> EnBolsinSaliente : CU 19 Generar bolsín,\nCU 20 Modificar bolsín (agregar) /\nagregarABolsin()
EnBolsinSaliente --> EnRemito : CU 20 Modificar bolsín (quitar),\nCU 21 Eliminar bolsín /\nquitarDeBolsin()
EnBolsinSaliente --> EnBolsinEnviado : CU 27 Registrar el retiro\nde bolsines / enviar()
EnBolsinEnviado -[#C0392B,bold]-> RecibidaYAceptada : <color:#C0392B><b>CU 28 [contenido igual\n<color:#C0392B><b>al registrado o documento recibido] /\n<color:#C0392B><b>recibir()
EnBolsinEnviado -[#C0392B,bold]-> NoRecibida : <color:#C0392B><b>CU 28 [no llegó] /\n<color:#C0392B><b>registrarNoRecibida()
EnBolsinEnviado -[#C0392B,bold]-> RecibidaYRechazada : <color:#C0392B><b>CU 28 [no corresponde\n<color:#C0392B><b>a la CM destino] / rechazar()
EnBolsinEnviado -[#C0392B,bold]-> ParaRedirigir : <color:#C0392B><b>CU 28 [la CM destino es la CMC\n<color:#C0392B><b>y va a otra área] / redirigir()
ParaRedirigir --> RecibidaYAceptada : Verificación del área de la CMC\n[documentación correcta] / aceptar()
ParaRedirigir --> RecibidaYRechazada : Verificación del área de la CMC\n[no corresponde al área] / rechazar()
NoRecibida --> Registrada : CU 31 Registrar revisión\n[se reenvía] / registrar()
NoRecibida --> DeBaja : CU 31 Registrar revisión\n[ya no es relevante] / darDeBaja()
RecibidaYRechazada --> Registrada : CU 31 Registrar revisión\n[se reenvía] / registrar()
RecibidaYRechazada --> DeBaja : CU 31 Registrar revisión / darDeBaja()
Registrada --> DeBaja : CU 9 Eliminar documentación /\ndarDeBaja()
RecibidaYAceptada --> [*]
DeBaja --> [*]
@enduml
