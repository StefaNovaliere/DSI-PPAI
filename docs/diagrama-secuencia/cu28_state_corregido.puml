@startuml
skinparam style strictuml
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam defaultFontColor #000000
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 4
skinparam sequence {
  ArrowColor #000000
  ArrowThickness 1
  LifeLineBorderColor #000000
  LifeLineBackgroundColor #FFFFFF
  ParticipantBorderColor #000000
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontSize 13
  ActorBorderColor #000000
  ActorBackgroundColor #FFFFFF
  BoundaryBorderColor #000000
  BoundaryBackgroundColor #FFFFFF
  ControlBorderColor #000000
  ControlBackgroundColor #FFFFFF
  EntityBorderColor #000000
  EntityBackgroundColor #FFFFFF
  GroupBorderColor #000000
  GroupBackgroundColor #FFFFFF
  GroupHeaderFontStyle plain
  GroupFontStyle plain
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #000000
}
skinparam boundary {
  BackgroundColor #FFFFFF
  BorderColor #000000
}
skinparam control {
  BackgroundColor #FFFFFF
  BorderColor #000000
}
skinparam entity {
  BackgroundColor #FFFFFF
  BorderColor #000000
}
skinparam participant {
  BackgroundColor #FFFFFF
  BorderColor #000000
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #000000
}
hide footbox
autonumber "0 :"
mainframe sd CU28 RegistrarRecepcionBolsin

actor ":EB" as EB
boundary ":PantallaRecepcionBolsin" as P
control ":GestorRecepcionBolsin" as G
entity "seleccionado: Bolsin" as B
participant "estadoActual: Enviado" as EN
entity ":CambioEstadoBolsin" as CEB
entity "actual: CambioEstadoBolsin" as ACEB
participant ":RecibidoEnCMDestino" as REC
entity "nuevo: CambioEstadoBolsin" as NCEB
entity ":Remito" as R
participant "estado: EnBolsinEnviado" as ER
participant ":RemitoRecibidoYAceptado" as RRA
entity ":DetalleRemito" as DR
entity ":Documentacion" as D
participant "estadoActual: EnBolsinEnviado" as ED
entity ":CambioEstadoDocumentacion" as CED
entity "actual: CambioEstadoDocumentacion" as ACED
participant ":RecibidaYAceptada" as RYA
entity "nuevo: CambioEstadoDocumentacion" as NCED

note over EB, G
  Los métodos anteriores se mantienen
  como en el análisis
end note

EB -> P : tomarConfirmacion(): void
activate P
P -> G : tomarConfirmacion(confirma: boolean): void
activate G
G -> G : getFechaYHoraActual(): LocalDateTime

G -> B : recibir(fechaHora: LocalDateTime,\nresponsable: Empleado): void
activate B
B -> EN : recibir(bolsin: Bolsin, fechaHora: LocalDateTime,\nresponsable: Empleado): void
activate EN
EN -> EN : buscarCambioEstadoActual(bolsin: Bolsin):\nCambioEstadoBolsin
activate EN
loop mientras haya cambios de estado
  EN -> CEB : ~*sosActual(): boolean
end
deactivate EN
EN -> ACEB : setFechaHoraFin(fechaHora: LocalDateTime): void
EN -> EN : crearEstado(): EstadoBolsin
activate EN
create REC
EN -->> REC : new()
deactivate EN
EN -> EN : crearCambioEstado(estado: EstadoBolsin,\nfechaHora: LocalDateTime, responsable: Empleado):\nCambioEstadoBolsin
activate EN
create NCEB
EN -->> NCEB : new(fechaHoraInicio: LocalDateTime,\nestado: EstadoBolsin, responsable: Empleado)
deactivate EN
EN -> B : setEstado(estado: EstadoBolsin): void
EN -> B : agregarCambioEstado(cambioEstado:\nCambioEstadoBolsin): void
deactivate EN
deactivate B

G -> B : recibirYAceptarRemito(fechaHora: LocalDateTime,\nresponsable: Empleado, opcion: OpcionRecepcion,\ndocumentacionIndicada: List<Integer>): void
activate B
loop mientras haya remitos
  B -> R : recibirYAceptar(fechaHora: LocalDateTime,\nresponsable: Empleado, opcion: OpcionRecepcion,\ndocumentacionIndicada: List<Integer>): void
  activate R
  R -> ER : recibirYAceptar(remito: Remito, fechaHora: LocalDateTime,\nresponsable: Empleado, opcion: OpcionRecepcion,\ndocumentacionIndicada: List<Integer>): void
  activate ER
  ER -> ER : crearEstado(remito: Remito, opcion: OpcionRecepcion,\ndocumentacionIndicada: List<Integer>): EstadoRemito
  activate ER
  create RRA
  ER -->> RRA : new()
  deactivate ER
  ER -> R : setEstado(estado: EstadoRemito): void
  ER -> R : getDetallesRemito(): List<DetalleRemito>
  ER -> ER : actualizarEstadoDocumentacion(detallesRemito: List<DetalleRemito>,\nfechaHora: LocalDateTime, responsable: Empleado,\nopcion: OpcionRecepcion, documentacionIndicada: List<Integer>): void
  activate ER
  loop mientras haya detalles de remito
    ER -> DR : recibirYAceptarDoc(fechaHora: LocalDateTime,\nresponsable: Empleado, opcion: OpcionRecepcion,\ndocumentacionIndicada: List<Integer>): void
    activate DR
    DR -> DR : esDocumentacionIndicada(\ndocumentacionIndicada: List<Integer>): boolean
    DR -> D : recibir(fechaHora: LocalDateTime, responsable: Empleado,\nsituacion: SituacionDocumentacion): void
    activate D
    D -> ED : recibir(documentacion: Documentacion,\nfechaHora: LocalDateTime, responsable: Empleado,\nsituacion: SituacionDocumentacion): void
    activate ED
    ED -> ED : buscarCambioEstadoActual(documentacion:\nDocumentacion): CambioEstadoDocumentacion
    activate ED
    loop mientras haya cambios de estado
      ED -> CED : ~*sosActual(): boolean
    end
    deactivate ED
    ED -> ACED : setFechaHoraFin(fechaHora: LocalDateTime): void
    ED -> ED : crearEstado(situacion: SituacionDocumentacion):\nEstadoDocumentacion
    activate ED
    create RYA
    ED -->> RYA : new()
    deactivate ED
    ED -> ED : crearCambioEstado(estado: EstadoDocumentacion,\nfechaHora: LocalDateTime, responsable: Empleado):\nCambioEstadoDocumentacion
    activate ED
    create NCED
    ED -->> NCED : new(fechaHoraInicio: LocalDateTime,\nestado: EstadoDocumentacion,\nresponsableCE: Empleado)
    deactivate ED
    ED -> D : setEstado(estado: EstadoDocumentacion): void
    ED -> D : agregarCambioEstado(cambioEstado:\nCambioEstadoDocumentacion): void
    deactivate ED
    deactivate D
    deactivate DR
  end
  deactivate ER
  deactivate ER
  deactivate R
end
deactivate B

note over G, R
  Los métodos posteriores se mantienen como en el análisis,
  salvo buscarCorreoCM(), que toma el correo de la CM origen
  del bolsín: seleccionado:Bolsin → obtenerCorreoCMOrigen().
end note
deactivate G
deactivate P
@enduml
